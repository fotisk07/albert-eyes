[Unit]
Description=Albert Eyes attached display

[Service]
ExecStart=%h/.local/bin/albert-eyes --mode screen
Restart=on-failure
RestartSec=1
Environment=TERM=linux
StandardInput=null
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no

[Install]
WantedBy=default.target
